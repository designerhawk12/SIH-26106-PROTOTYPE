# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=26214400
# Explicit opt-in only. Synthetic enrichment is disabled by default.
DEMO_MODE=false

# Docker Compose host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Persistence (SQLite is for local development only)
# DATABASE_URL=sqlite:///./email_threat_platform.db
# Supabase PostgreSQL (copy the connection string from the Supabase dashboard)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional Compose-only override (defaults to a SQLite named-volume path)
# DOCKER_DATABASE_URL=sqlite:////data/email_threat_platform.db

# Browser/API access
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# Optional threat-intelligence and geolocation providers
# Keep real values only in the local environment or a secret manager.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
